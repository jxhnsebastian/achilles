generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Agents {
  id                     Int      @id @default(autoincrement()) @map("id")
  name                   String   @map("name")
  twitter                String[] @map("twitter")
  framework              String   @map("framework")
  contracts              Json[]
  ticker                 String   @map("ticker")
  creationDate           DateTime @map("creation_date")
  profileImageUrl        String   @map("profile_image_url")
  marketCapGraph         Json[]
  marketCap              Float    @map("market_cap")
  marketCapDelta         Float    @map("market_cap_delta")
  price                  Float    @map("price")
  priceDelta             Float    @map("price_delta")
  holdersCount           Int      @map("holders_count")
  holdersCountDelta      Int      @map("holders_count_delta")
  volume24Hours          Float    @map("volume_24_hours")
  volume24HoursDelta     Float    @map("volume_24_hours_delta")
  liquidity              Float    @map("liquidity")
  liquidityDelta         Float    @map("liquidity_delta")
  mindshare              Float    @map("mindshare")
  mindshareDelta         Float    @map("mindshare_delta")
  echo                   Float    @map("echo")
  echoDelta              Float    @map("echo_delta")
  followers              Int      @map("followers")
  followersDelta         Int      @map("followers_delta")
  smartFollowers         Int      @map("smart_followers")
  smartFollowersDelta    Int      @map("smart_followers_delta")
  impressionsMetrics     Json?
  engagementsMetrics     Json?
  smartEngagementMetrics Json?
  bestTweets             Json[]
  timestamp              DateTime

  @@index([name, ticker, timestamp])
  @@map("agents")
}

model Wallets {
  id                  Int                        @id @default(autoincrement())
  walletAddress       String                     @map("wallet_address")
  name                String
  chain               String
  snapshotTime        DateTime                   @map("snapshot_time")
  createdAt           DateTime                   @default(now()) @map("created_at")
  total_fund_invested Decimal                    @default(0) @db.Decimal(24, 8)
  lendingBorrowing    ProtocolLendingBorrowing[]
  liquidityPools      ProtocolLp[]
  stakingLocking      ProtocolStakingLocking[]
  tokenBalances       TokenBalance[]

  @@unique([walletAddress, snapshotTime])
  @@map("wallets")
}

model Tokens {
  tokenId          String                     @id @map("token_id")
  contractAddress  String                     @map("contract_address")
  chain            String
  tokenName        String                     @map("token_name")
  tokenSymbol      String                     @map("token_symbol")
  logoUrl          String?                    @map("logo_url")
  verified         Boolean                    @map("verified")
  decimals         Int                        @default(18)
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  lendingBorrowing ProtocolLendingBorrowing[]
  lpToken1         ProtocolLp[]               @relation("Token1")
  lpToken2         ProtocolLp[]               @relation("Token2")
  lpRewards        ProtocolLpRewards[]
  stakingLocking   ProtocolStakingLocking[]
  stakingRewards   ProtocolStakingRewards[]
  balances         TokenBalance[]

  @@map("tokens")
}

model TokenBalance {
  id            Int      @id @default(autoincrement())
  walletAddress String   @map("wallet_address")
  source        String
  chain         String
  tokenPrice    Decimal  @map("token_price") @db.Decimal(24, 8)
  tokenAmount   Decimal  @map("token_amount") @db.Decimal(36, 18)
  balanceUsd    Decimal  @map("balance_usd") @db.Decimal(24, 8)
  snapshotTime  DateTime @map("snapshot_time")
  createdAt     DateTime @default(now()) @map("created_at")
  tokenId       String   @map("token_id")
  walletId      Int      @map("wallet_id")
  token         Tokens   @relation(fields: [tokenId], references: [tokenId])
  wallet        Wallets  @relation(fields: [walletId], references: [id])

  @@map("token_balance")
}

model ProtocolLendingBorrowing {
  id            Int      @id @default(autoincrement())
  protocolName  String   @map("protocol_name")
  chain         String
  walletAddress String   @map("wallet_address")
  isBorrowed    Boolean  @map("is_borrowed")
  tokenPrice    Decimal  @map("token_price") @db.Decimal(24, 8)
  tokenAmount   Decimal  @map("token_amount") @db.Decimal(36, 18)
  totalValue    Decimal  @map("total_value") @db.Decimal(24, 8)
  healthRatio   Decimal? @map("health_ratio") @db.Decimal(10, 4)
  borrowApy     Decimal? @map("borrow_apy") @db.Decimal(10, 4)
  lendingApy    Decimal? @map("lending_apy") @db.Decimal(10, 4)
  snapshotTime  DateTime @map("snapshot_time")
  createdAt     DateTime @default(now()) @map("created_at")
  tokenId       String   @map("token_id")
  walletId      Int      @map("wallet_id")
  token         Tokens   @relation(fields: [tokenId], references: [tokenId])
  wallet        Wallets  @relation(fields: [walletId], references: [id])

  @@map("protocol_lending_borrowing")
}

model ProtocolLp {
  id              Int                 @id @default(autoincrement())
  protocolName    String              @map("protocol_name")
  chain           String
  walletAddress   String              @map("wallet_address")
  poolId          String              @map("pool_id")
  isInRange       Boolean             @map("is_in_range")
  token1Amount    Decimal             @map("token_1_amount") @db.Decimal(36, 18)
  token1UsdValue  Decimal             @map("token_1_usd_value") @db.Decimal(24, 8)
  token1Price     Decimal             @map("token_1_price") @db.Decimal(24, 8)
  token2Amount    Decimal             @map("token_2_amount") @db.Decimal(36, 18)
  token2UsdValue  Decimal             @map("token_2_usd_value") @db.Decimal(24, 8)
  token2Price     Decimal             @map("token_2_price") @db.Decimal(24, 8)
  totalLpUsdValue Decimal             @map("total_lp_usd_value") @db.Decimal(24, 8)
  snapshotTime    DateTime            @map("snapshot_time")
  createdAt       DateTime            @default(now()) @map("created_at")
  token1Id        String              @map("token_1_id")
  token2Id        String              @map("token_2_id")
  walletId        Int                 @map("wallet_id")
  token1          Tokens              @relation("Token1", fields: [token1Id], references: [tokenId])
  token2          Tokens              @relation("Token2", fields: [token2Id], references: [tokenId])
  wallet          Wallets             @relation(fields: [walletId], references: [id])
  rewards         ProtocolLpRewards[]

  @@map("protocol_lp")
}

model ProtocolLpRewards {
  id             Int        @id @default(autoincrement())
  rewardAmount   Decimal    @map("reward_amount") @db.Decimal(36, 18)
  rewardPrice    Decimal    @map("reward_price") @db.Decimal(24, 8)
  rewardUsdValue Decimal    @map("reward_usd_value") @db.Decimal(24, 8)
  snapshotTime   DateTime   @map("snapshot_time")
  createdAt      DateTime   @default(now()) @map("created_at")
  lpId           Int        @map("lp_id")
  rewardTokenId  String     @map("reward_token_id")
  lp             ProtocolLp @relation(fields: [lpId], references: [id])
  rewardToken    Tokens     @relation(fields: [rewardTokenId], references: [tokenId])

  @@map("protocol_lp_rewards")
}

model ProtocolStakingLocking {
  id            Int                      @id @default(autoincrement())
  protocolName  String                   @map("protocol_name")
  chain         String
  walletAddress String                   @map("wallet_address")
  tokenAmount   Decimal                  @map("token_amount") @db.Decimal(36, 18)
  tokenPrice    Decimal                  @map("token_price") @db.Decimal(24, 8)
  totalValue    Decimal                  @map("total_value") @db.Decimal(24, 8)
  isLocked      Boolean                  @default(false) @map("is_locked")
  lockDuration  String?                  @map("lock_duration")
  stakingApy    Decimal?                 @map("staking_apy") @db.Decimal(10, 4)
  lockApy       Decimal?                 @map("lock_apy") @db.Decimal(10, 4)
  snapshotTime  DateTime                 @map("snapshot_time")
  createdAt     DateTime                 @default(now()) @map("created_at")
  tokenId       String                   @map("token_id")
  walletId      Int                      @map("wallet_id")
  token         Tokens                   @relation(fields: [tokenId], references: [tokenId])
  wallet        Wallets                  @relation(fields: [walletId], references: [id])
  rewards       ProtocolStakingRewards[]

  @@map("protocol_staking_locking")
}

model ProtocolStakingRewards {
  id             Int                    @id @default(autoincrement())
  rewardAmount   Decimal                @map("reward_amount") @db.Decimal(36, 18)
  rewardPrice    Decimal                @map("reward_price") @db.Decimal(24, 8)
  rewardUsdValue Decimal                @map("reward_usd_value") @db.Decimal(24, 8)
  snapshotTime   DateTime               @map("snapshot_time")
  createdAt      DateTime               @default(now()) @map("created_at")
  stakingId      Int                    @map("staking_id")
  rewardTokenId  String                 @map("reward_token_id")
  rewardToken    Tokens                 @relation(fields: [rewardTokenId], references: [tokenId])
  staking        ProtocolStakingLocking @relation(fields: [stakingId], references: [id])

  @@map("protocol_staking_rewards")
}

model arbitrage_data {
  id             Int      @default(autoincrement())
  base_symbol    String   @db.VarChar(20)
  quote_symbol   String   @db.VarChar(20)
  source_low     String   @db.VarChar(50)
  source_high    String   @db.VarChar(50)
  price_low      Decimal  @db.Decimal(20, 10)
  price_high     Decimal  @db.Decimal(20, 10)
  price_diff_pct Decimal  @db.Decimal(10, 6)
  timestamp      DateTime @db.Timestamptz(6)

  @@id([id, timestamp])
  @@index([timestamp(sort: Desc)])
  @@index([base_symbol, quote_symbol], map: "idx_arbitrage_data_symbols")
}

model binance_orderbook_depth {
  timestamp        DateTime @db.Timestamptz(6)
  depth_percentage Decimal  @db.Decimal(5, 2)
  buy_volume       Decimal  @db.Decimal(30, 10)
  sell_volume      Decimal  @db.Decimal(30, 10)

  @@id([timestamp, depth_percentage])
  @@index([timestamp(sort: Desc)])
}

model liquidity_data {
  id           Int      @default(autoincrement())
  source       String   @db.VarChar(50)
  base_symbol  String   @db.VarChar(20)
  quote_symbol String   @db.VarChar(20)
  liquidity    Decimal  @db.Decimal(30, 2)
  timestamp    DateTime @db.Timestamptz(6)

  @@id([id, timestamp])
  @@index([source, base_symbol, quote_symbol], map: "idx_liquidity_data_source_symbols")
  @@index([timestamp(sort: Desc)])
}

model orderbook_depth {
  id           Int      @default(autoincrement())
  source       String   @db.VarChar(50)
  base_symbol  String   @db.VarChar(20)
  quote_symbol String   @db.VarChar(20)
  bid_volume   Decimal  @db.Decimal(30, 2)
  ask_volume   Decimal  @db.Decimal(30, 2)
  spread       Decimal  @db.Decimal(10, 6)
  depth_ratio  Decimal  @db.Decimal(10, 6)
  timestamp    DateTime @db.Timestamptz(6)

  @@id([id, timestamp])
  @@index([source, base_symbol, quote_symbol], map: "idx_orderbook_depth_source_symbols")
  @@index([timestamp(sort: Desc)])
}

model price_data {
  id           Int      @default(autoincrement())
  source       String   @db.VarChar(50)
  base_symbol  String   @db.VarChar(20)
  quote_symbol String   @db.VarChar(20)
  price        Decimal  @db.Decimal(20, 10)
  volume_24h   Decimal? @db.Decimal(30, 2)
  timestamp    DateTime @db.Timestamptz(6)

  @@id([id, timestamp])
  @@index([source, base_symbol, quote_symbol], map: "idx_price_data_source_symbols")
  @@index([timestamp(sort: Desc)])
}

