  timestamp             DateTime @id @db.Timestamptz(6)
  binance_price         Decimal  @db.Decimal(20, 10)
  cetus_price           Decimal  @db.Decimal(20, 10)
  bluefin_price         Decimal  @db.Decimal(20, 10)
  binance_cetus_delta   Decimal  @db.Decimal(20, 10)
  binance_bluefin_delta Decimal  @db.Decimal(20, 10)

  @@index([timestamp(sort: Desc)], map: "idx_sui_arbitrage_data_timestamp")
}

/// This table has subclasses and requires additional setup for migrations. Visit https://pris.ly/d/table-inheritance for more info.
model sui_fee_growth_data {
  timestamp     DateTime @db.Timestamptz(6)
  pool_address  String   @db.VarChar(100)
  fee_growth_a  Decimal  @db.Decimal(40, 10)
  fee_growth_b  Decimal  @db.Decimal(40, 10)
  token_a_price Decimal  @db.Decimal(30, 10)
  token_b_price Decimal  @db.Decimal(30, 10)
  fee_rate      Decimal  @db.Decimal(10, 6)

  @@id([timestamp, pool_address])
  @@index([timestamp(sort: Desc)], map: "idx_sui_fee_growth_data_timestamp")
  @@index([timestamp(sort: Desc)])
}

/// This table has subclasses and requires additional setup for migrations. Visit https://pris.ly/d/table-inheritance for more info.
model sui_liquidity_data {
  timestamp     DateTime @db.Timestamptz(6)
  source        String   @db.VarChar(50)
  liquidity_usd Decimal  @db.Decimal(30, 10)
  volume_1h     Decimal? @db.Decimal(30, 10)
  raw_data      Json?

  @@id([timestamp, source])
  @@index([timestamp(sort: Desc)], map: "idx_sui_liquidity_data_timestamp")
  @@index([timestamp(sort: Desc)])
}

/// This table has subclasses and requires additional setup for migrations. Visit https://pris.ly/d/table-inheritance for more info.
model sui_price_data {
  timestamp  DateTime @db.Timestamptz(6)
  source     String   @db.VarChar(50)
  sui_price  Decimal  @db.Decimal(20, 10)
  volume_24h Decimal? @db.Decimal(30, 10)

  @@id([timestamp, source])
  @@index([timestamp(sort: Desc)], map: "idx_sui_price_data_timestamp")
  @@index([timestamp(sort: Desc)])
  @@index([source], map: "idx_price_source")
  @@index([timestamp], map: "idx_price_timestamp")
}

/// This table has subclasses and requires additional setup for migrations. Visit https://pris.ly/d/table-inheritance for more info.
model all_crypto_prices {
  time   DateTime @db.Timestamptz(6)
  symbol String
  open   Float?
  high   Float?
  low    Float?
  close  Float?
  volume Float?

  @@id([time, symbol])
  @@index([time(sort: Desc)])
  @@index([symbol], map: "idx_all_crypto_prices_symbol")
}

/// This table has subclasses and requires additional setup for migrations. Visit https://pris.ly/d/table-inheritance for more info.
model solana_pool_data {
  timestamp           DateTime @db.Timestamptz(6)
  pool_address        String
  token_a_amount      Decimal  @db.Decimal
  token_b_amount      Decimal  @db.Decimal
  sqrt_price          Decimal  @db.Decimal
  liquidity           Decimal  @db.Decimal
  tick_current        Int
  fee_growth_global_a Decimal  @db.Decimal
  fee_growth_global_b Decimal  @db.Decimal

  @@id([timestamp, pool_address])
  @@index([pool_address, timestamp(sort: Desc)], map: "idx_pool_data_pool_address")
  @@index([timestamp(sort: Desc)])
  @@index([pool_address, timestamp(sort: Desc)], map: "idx_solana_pool_data_pool_address")
}

/// This table has subclasses and requires additional setup for migrations. Visit https://pris.ly/d/table-inheritance for more info.
model solana_price_data {
  timestamp     DateTime @db.Timestamptz(6)
  pool_address  String
  price         Decimal  @db.Decimal
  volume_24h    Decimal? @db.Decimal
  liquidity_usd Decimal? @db.Decimal

  @@id([timestamp, pool_address])
  @@index([pool_address, timestamp(sort: Desc)], map: "idx_price_data_pool_address")
  @@index([timestamp(sort: Desc)])
  @@index([pool_address, timestamp(sort: Desc)], map: "idx_solana_price_data_pool_address")
}

model sui_arbitrage_data_v2 {
  timestamp   DateTime @db.Timestamptz(6)
  pair        String
  source1     String
  source2     String
  price1      Decimal  @db.Decimal
  price2      Decimal  @db.Decimal
  price_delta Decimal  @db.Decimal

  @@id([timestamp, pair, source1, source2])
  @@index([timestamp], map: "idx_sui_arbitrage_data_v2_timestamp")
}

model sui_pool_data_v2 {
  timestamp     DateTime @db.Timestamptz(6)
  source        String
  pair          String
  pool_address  String
  liquidity     Decimal  @db.Decimal
  liquidity_usd Decimal  @db.Decimal
  volume_1h     Decimal  @db.Decimal
  volume_24h    Decimal? @db.Decimal
  fee_rate      Decimal? @db.Decimal
  raw_data      Json?

  @@id([timestamp, pool_address])
  @@index([timestamp], map: "idx_sui_pool_data_v2_timestamp")
}

model sui_price_data_v2 {
  timestamp   DateTime @db.Timestamptz(6)
  source      String
  pair        String
  price       Decimal  @db.Decimal
  volume_24h  Decimal  @db.Decimal
  data_source String?  @db.VarChar(50)

  @@id([timestamp, source, pair])
  @@index([timestamp], map: "idx_sui_price_data_v2_timestamp")
}

model sui_ticks_data {
  timestamp                DateTime @db.Timestamptz(6)
  pool_address             String
  tick_index               Int
  liquidity_net            Decimal? @db.Decimal
  liquidity_gross          Decimal? @db.Decimal
  sqrt_price               Decimal? @db.Decimal
  fee_growth_outside_a     Decimal? @db.Decimal
  fee_growth_outside_b     Decimal? @db.Decimal
  seconds_outside          Decimal? @db.Decimal
  tick_data                Json?
  source                   String   @default("cetus")
  object_id                String?
  rewarders_growth_outside Json?

  @@id([timestamp, pool_address, tick_index])
  @@index([source], map: "idx_sui_ticks_data_source")
  @@index([timestamp], map: "idx_sui_ticks_data_timestamp")
}

model BotMemory {
  id            String   @id @default(uuid())
  botId         String
  action        String
  timestamp     DateTime @default(now())
  digest        String
  coinA         Decimal
  coinB         Decimal
  price         Decimal
  l_coefficient Decimal
  value         Decimal
  strategyData  Json
  balances      Json

  @@index([botId, timestamp])
  @@map("bot_memory")
}

model funding_rate_history {
  id            String   @id
  walletAddress String
  coin          String
  fundingRate   Float
  szi           Float?
  usdc          Float?
  timestamp     DateTime
  hash          String
  createdAt     DateTime @default(now())

  @@index([coin, timestamp])
  @@index([walletAddress, coin, timestamp])
}

model perp_fill {
  id            String   @id
  fillId        String   @unique
  orderId       String
  walletAddress String
  coin          String
  direction     String
  side          String
  price         Float
  size          Float
  value         Float
  fee           Float
  builderFee    Float?
  closedPnl     Float
  isCrossed     Boolean
  startPosition Float?
  timestamp     DateTime
  hash          String
  createdAt     DateTime @default(now())

  @@index([coin, timestamp])
  @@index([orderId, timestamp])
}

model BotMemoryV2 {
  id        String    @id @default(uuid())
  botId     String
  action    String
  timestamp DateTime  @default(now())
  digest    String
  coinA     Json
  coinB     Json
  price     Decimal
  strategy  Json
  balances  Json
  user      String?
  botConfig BotConfig @relation(fields: [botId], references: [botId])

  @@index([botId, timestamp])
  @@map("bot_memory_v2")
}

model BotConfig {
  id          String        @id @default(uuid())
  botId       String        @unique
  sender      String
  protocol    Protocol
  strategy    StrategyType
  poolId      String
  slippage    Float
  params      Json?
  continue    Boolean?
  status      BotStatus
  instanceId  String
  timestamp   DateTime      @default(now())
  botMemories BotMemoryV2[]

  @@index([botId])
  @@map("bot_config")
}

model Pollers {
  id       String       @id @default(uuid())
  pollerId String
  protocol Protocol
  poolId   String       @unique
  status   PollerStatus

  @@index([poolId])
  @@map("pollers")
}

enum StrategyType {
  CHASER
  INRANGE
}

enum Protocol {
  BLUEFIN
  CETUS
  ORCA
  RAYDIUM
}

enum BotStatus {
  START
  RUN
  REBALANCE
  UPDATE
  STOP
}

enum PollerStatus {
  START
  RUN
  RESTART
  STOP
}

model OrderBookBot {
  id              String        @id @default(uuid())
  orderSize       Float
  maxPositionSize Float
  gamma           Float
  ticker          String
  exchange        String
  duration        Float
  status          String
  instanceId      String

  @@map("order_book_bot")
}